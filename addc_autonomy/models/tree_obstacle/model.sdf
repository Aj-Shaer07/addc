<?xml version="1.0"?>
<sdf version="1.6">
  <model name="tree_obstacle">
    <static>true</static>
    <link name="tree_link">
      <!-- Trunk -->
      <collision name="trunk_collision">
        <pose>0 0 1.5 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>3.0</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="trunk_visual">
        <pose>0 0 1.5 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>3.0</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.4 0.25 0.1 1.0</ambient>
          <diffuse>0.4 0.25 0.1 1.0</diffuse>
        </material>
      </visual>

      <!-- Foliage / Canopy -->
      <collision name="canopy_collision">
        <pose>0 0 3.5 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>1.5</radius>
          </sphere>
        </geometry>
      </collision>
      <visual name="canopy_visual">
        <pose>0 0 3.5 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>1.5</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.1 0.6 0.15 1.0</ambient>
          <diffuse>0.15 0.7 0.2 1.0</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
